VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://localhost:8080

# Development-only token injection in Vite proxy.
# Keep this value identical to backend WORKFLOW_LOCAL_DEV_SECRET.
WORKFLOW_LOCAL_DEV_SECRET=change-me-local-dev-secret
WORKFLOW_CLIENT_CODE=local-dev
WORKFLOW_TENANT_CODE=default
WORKFLOW_TOKEN_VERSION=1
